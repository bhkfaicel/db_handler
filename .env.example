# Optional: override config file path
# CONFIG_FILE=config.json

# Optional: used by some tooling (e.g. sqlx)
# DATABASE_URL=sqlite:data/home_iot.db

# Optional: environment label
# ENVIRONMENT=development

# Required for Docker tests when using Forgejo registry for db_derive (read-only token)
# CARGO_REGISTRIES_FORGEJO_TOKEN=your_forgejo_read_only_token
